{
  "openapi": "3.0.3",
  "info": {
    "title": "Анализ применимости CVE",
    "version": "1.0.0",
    "description": "Сервис ставит задачу на анализ Git-репозитория и потом отдаёт статус и вывод.\n\nПорядок такой: `POST /api/v1/analysis` возвращает `id`. Дальше `GET /api/v1/analysis/{id}` — пока задача в очереди или в работе, `applicability` равен `null`. Когда статус `COMPLETED`, в ответе есть признак применимости и модули с вердиктом. `FAILED` отдаёт `error_msg` и `applicability` = `uncertain`.\n\nКнопка с дашборда открывает `GET /api/v1/analysis/open`: сервер находит последний анализ по четырём параметрам или создаёт новый и перенаправляет браузер на страницу анализа. `GET /api/v1/analysis/status` с теми же параметрами только отвечает, чем закончился самый новый анализ, и ничего не создаёт.\n\n`applicability`: `applicable` — уязвимость применима хотя бы в одном модуле, `not_applicable` — неприменима во всех, `uncertain` — применимых нет, но вывод не уверенный."
  },
  "servers": [
    {
      "url": "/",
      "description": "Тот хост, с которого открыт Swagger"
    }
  ],
  "tags": [
    {
      "name": "analysis",
      "description": "Задачи анализа применимости"
    }
  ],
  "paths": {
    "/api/v1/analysis/default-model": {
      "get": {
        "tags": ["analysis"],
        "operationId": "defaultAnalysisModel",
        "summary": "Модель по умолчанию",
        "description": "Имя из AI_MODEL. Форма показывает его до выбора другой модели.",
        "responses": {
          "200": {
            "description": "Модель из окружения",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["model"],
                  "properties": { "model": { "type": "string", "example": "env-model" } }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analysis/models": {
      "get": {
        "tags": ["analysis"],
        "operationId": "listAnalysisModels",
        "summary": "Список доступных моделей",
        "description": "Прокси к GET /v1/models контура модели. Токен остаётся на сервере.",
        "responses": {
          "200": {
            "description": "Имена моделей",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["models"],
                  "properties": {
                    "models": { "type": "array", "items": { "type": "string" }, "example": ["env-model", "other-model"] }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Контур модели не ответил",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "503": {
            "description": "Список моделей не настроен",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/v1/analysis/open": {
      "get": {
        "tags": ["analysis"],
        "operationId": "openAnalysis",
        "summary": "Открыть анализ по четырём параметрам",
        "description": "Ссылка для кнопки «Посмотреть анализ в CVE Verdict». Браузер открывает этот адрес, в ответе редирект на страницу анализа.\n\nСервер ищет самый новый анализ с теми же `component_url`, `branch`, `cve_id` и `package_name`. Сравнение точное, пробелы по краям отбрасываются. Алиас и CVE ID — разные строки. Статус не важен: откроется и готовый анализ, и ещё идущий, и упавший с ошибкой.\n\nЕсли совпадения нет, создаётся новый анализ с моделью из `AI_MODEL` и ставится в очередь. Редирект ведёт уже на него.\n\n`Location` — путь `/analysis/{id}` на том же хосте. Если задан `WEB_BASE_URL`, адрес абсолютный: `{WEB_BASE_URL}/analysis/{id}`.",
        "parameters": [
          {
            "name": "component_url",
            "in": "query",
            "required": true,
            "description": "Git-адрес репозитория.",
            "schema": { "type": "string", "example": "https://github.com/golang/example" }
          },
          {
            "name": "branch",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "master" }
          },
          {
            "name": "cve_id",
            "in": "query",
            "required": true,
            "description": "CVE ID или алиас. Ищется ровно та строка, с которой анализ был создан.",
            "schema": { "type": "string", "example": "CVE-2024-0001" }
          },
          {
            "name": "package_name",
            "in": "query",
            "required": true,
            "description": "Имя уязвимого пакета.",
            "schema": { "type": "string", "example": "example" }
          }
        ],
        "responses": {
          "302": {
            "description": "Страница анализа. Если подходящей задачи не было, она создана и поставлена в очередь.",
            "headers": {
              "Location": {
                "description": "Адрес страницы анализа.",
                "schema": {
                  "type": "string",
                  "example": "/analysis/8f14e45f-ceea-4e4a-a3c2-3f6e1b0d9a11"
                }
              }
            }
          },
          "400": {
            "description": "Не хватает одного из четырёх параметров",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "invalid input: component_url, branch, cve_id and package_name are required" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/api/v1/analysis/status": {
      "get": {
        "tags": ["analysis"],
        "operationId": "checkAnalysis",
        "summary": "Проверить статус по четырём параметрам",
        "description": "Кнопка «Проверить статус» на дашборде. Те же четыре параметра, что у открытия анализа. Сервер ищет самый новый анализ и ничего не создаёт.\n\nВ ответе одно поле `result`:\n\n- `applicable` — анализ закончен, уязвимость применима\n- `not_applicable` — анализ закончен, уязвимость неприменима\n- `uncertain` — анализ закончен, вывод неуверенный\n- `not_started` — такой четвёрки в базе нет\n- `in_progress` — задача в очереди или уже выполняется\n- `failed` — проверка запускалась и закончилась ошибкой\n\nУпавший анализ не отдаётся как `uncertain`. Сравнение строк точное, пробелы по краям отбрасываются. Алиас и CVE ID — разные значения.",
        "parameters": [
          {
            "name": "component_url",
            "in": "query",
            "required": true,
            "description": "Git-адрес репозитория.",
            "schema": { "type": "string", "example": "https://github.com/golang/example" }
          },
          {
            "name": "branch",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "master" }
          },
          {
            "name": "cve_id",
            "in": "query",
            "required": true,
            "description": "CVE ID или алиас. Ищется ровно та строка, с которой анализ был создан.",
            "schema": { "type": "string", "example": "CVE-2024-0001" }
          },
          {
            "name": "package_name",
            "in": "query",
            "required": true,
            "description": "Имя уязвимого пакета.",
            "schema": { "type": "string", "example": "example" }
          }
        ],
        "responses": {
          "200": {
            "description": "Один из шести результатов. Отсутствие анализа — это `not_started`, не ошибка.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CheckResult" },
                "example": { "result": "in_progress" }
              }
            }
          },
          "400": {
            "description": "Не хватает одного из четырёх параметров",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "invalid input: component_url, branch, cve_id and package_name are required" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/api/v1/analysis": {
      "post": {
        "tags": ["analysis"],
        "operationId": "createAnalysis",
        "summary": "Создать задачу",
        "description": "Ставит анализ в очередь. В ответе только `id` созданной задачи. Все четыре поля обязательны.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateAnalysisRequest" },
              "example": {
                "component_url": "https://github.com/golang/example",
                "branch": "master",
                "cve_id": "CVE-2024-0001",
                "package_name": "example"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Задача создана и поставлена в очередь",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateAnalysisResponse" },
                "example": { "id": "8f14e45f-ceea-4e4a-a3c2-3f6e1b0d9a11" }
              }
            }
          },
          "400": {
            "description": "Тело не JSON или не хватает поля",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "json": { "value": { "error": "invalid JSON" } },
                  "fields": { "value": { "error": "invalid input: component_url, branch, cve_id and package_name are required" } }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      },
      "get": {
        "tags": ["analysis"],
        "operationId": "listAnalyses",
        "summary": "Список задач",
        "description": "Короткие карточки без вердикта и отчёта. `total` — сколько записей подходит под тот же фильтр `status`, без учёта `limit` и `offset`.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Размер страницы. По умолчанию 10, больше 100 обрезается до 100.",
            "schema": { "type": "integer", "minimum": 1, "default": 10 }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Смещение от начала списка. Не может быть отрицательным.",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Необязательный фильтр по статусу.",
            "schema": { "$ref": "#/components/schemas/Status" }
          }
        ],
        "responses": {
          "200": {
            "description": "Страница списка",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnalysisList" },
                "example": {
                  "items": [
                    {
                      "id": "8f14e45f-ceea-4e4a-a3c2-3f6e1b0d9a11",
                      "status": "COMPLETED",
                      "cve_id": "CVE-2024-0001",
                      "component_url": "https://github.com/golang/example",
                      "branch": "master",
                      "package_name": "example",
                      "created_at": "2026-01-01T00:00:00Z",
                      "duration_ms": 1200,
                      "applicability": "not_applicable"
                    }
                  ],
                  "total": 1
                }
              }
            }
          },
          "400": {
            "description": "Неверные limit, offset или status",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/api/v1/analysis/{id}": {
      "get": {
        "tags": ["analysis"],
        "operationId": "getAnalysis",
        "summary": "Статус и результат по id",
        "description": "Полная задача. Пока статус `PENDING` или `RUNNING`, `applicability` равен `null`, а `modules` пустой. У `COMPLETED` у каждого модуля есть `verdict`, `applicability` и журнал `report_md`. У `FAILED` заполнен `error_msg`.\n\n`clone_ms` — миллисекунды клонирования запрошенной ветки. Появляется сразу после клона, в том числе если клон или анализ оборвались по дедлайну. `ai_calls`, `ai_min_ms` и `ai_max_ms` — сколько раз этот анализ обращался к модели и сколько миллисекунд ждали самый быстрый и самый долгий ответ. Неудачный ответ тоже считается. После завершения, ошибки и обрыва по дедлайну цифры остаются: если обращений не было, `ai_calls` равен 0, а времена `null`.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Идентификатор из ответа на создание задачи.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Задача найдена",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnalysisTask" },
                "examples": {
                  "running": {
                    "summary": "Ещё считается",
                    "value": {
                      "id": "8f14e45f-ceea-4e4a-a3c2-3f6e1b0d9a11",
                      "status": "RUNNING",
                      "component_url": "https://github.com/golang/example",
                      "branch": "master",
                      "cve_id": "CVE-2024-0001",
                      "package_name": "example",
                      "modules": [],
                      "error_msg": "",
                      "created_at": "2026-01-01T00:00:00Z",
                      "updated_at": "2026-01-01T00:00:05Z",
                      "duration_ms": 5000,
                      "applicability": null
                    }
                  },
                  "completed": {
                    "summary": "Готовый вывод",
                    "value": {
                      "id": "8f14e45f-ceea-4e4a-a3c2-3f6e1b0d9a11",
                      "status": "COMPLETED",
                      "component_url": "https://github.com/golang/example",
                      "branch": "master",
                      "cve_id": "CVE-2024-0001",
                      "package_name": "example",
                      "modules": [
                        {
                          "go_mod_path": "go.mod",
                          "verdict": "Потенциальная уязвимость CVE-2024-0001 неприменима, хоть и зависимость есть версии v1.2.3. Все дело в том, что описанный уязвимый код в эту программу не входит.",
                          "applicability": "not_applicable",
                          "report_md": "Сначала проверили дерево исходников.\n"
                        }
                      ],
                      "error_msg": "",
                      "created_at": "2026-01-01T00:00:00Z",
                      "updated_at": "2026-01-01T00:06:28Z",
                      "duration_ms": 388000,
                      "applicability": "not_applicable"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Задачи с таким id нет",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "task not found" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/api/v1/analysis/{id}/cancel": {
      "post": {
        "tags": ["analysis"],
        "operationId": "cancelAnalysis",
        "summary": "Остановить анализ",
        "description": "Останавливает задачу в очереди или в работе. Статус становится `FAILED`, `applicability` — `uncertain`, а `error_msg` — «Остановлен принудительно нажатием на кнопку \"Остановить анализ\"». Это не сбой модели, Git или сервиса патчей, поэтому `error_source` пустой. Текущая работа прерывается.\n\nУже завершённую или уже упавшую задачу ручка не меняет.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Анализ остановлен",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "status"],
                  "properties": {
                    "id": { "type": "string" },
                    "status": { "type": "string", "example": "FAILED" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Задачи с таким id нет",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "409": {
            "description": "Задачу уже нельзя остановить",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "task cannot be cancelled" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/api/v1/analysis/{id}/report": {
      "get": {
        "tags": ["analysis"],
        "operationId": "downloadAnalysisReport",
        "summary": "Скачать отчёт",
        "description": "Журнал анализа одним markdown-файлом. Отдаётся только для статуса `COMPLETED`.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Файл отчёта",
            "content": {
              "text/markdown": {
                "schema": { "type": "string" },
                "example": "# go.mod\n\nСначала проверили дерево исходников.\n"
              }
            }
          },
          "404": {
            "description": "Задачи с таким id нет",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "409": {
            "description": "Задача ещё не завершена",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "task is not completed" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAnalysisRequest": {
        "type": "object",
        "required": ["component_url", "branch", "cve_id", "package_name"],
        "properties": {
          "component_url": {
            "type": "string",
            "description": "Git-адрес репозитория. Подходит HTTPS и git@host:path.",
            "example": "https://github.com/golang/example"
          },
          "branch": { "type": "string", "example": "master" },
          "cve_id": {
            "type": "string",
            "description": "CVE ID или алиас.",
            "example": "CVE-2024-0001"
          },
          "package_name": {
            "type": "string",
            "description": "Имя уязвимого модуля. `root` ищет файлы патча от корня репозитория.",
            "example": "example"
          },
          "model": {
            "type": "string",
            "description": "Модель для этого анализа. Пустое значение — модель из AI_MODEL. Если у неё переполнена очередь AI HUB, анализ продолжается на Qwen/Qwen3.6-35B-A3B, затем на GigaChat-2-Pro. В готовой задаче лежит модель, которая дописала вывод.",
            "example": "env-model"
          }
        }
      },
      "CheckResult": {
        "type": "object",
        "required": ["result"],
        "properties": {
          "result": {
            "type": "string",
            "enum": ["applicable", "not_applicable", "uncertain", "not_started", "in_progress", "failed"],
            "description": "applicable — применима, not_applicable — неприменима, uncertain — неопределенно, not_started — анализ еще не запускался, in_progress — в очереди или выполняется, failed — упал."
          }
        }
      },
      "CreateAnalysisResponse": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор задачи. Его передают в GET, чтобы узнать статус и результат.",
            "example": "8f14e45f-ceea-4e4a-a3c2-3f6e1b0d9a11"
          }
        }
      },
      "AnalysisList": {
        "type": "object",
        "required": ["items", "total"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AnalysisSummary" }
          },
          "total": { "type": "integer", "example": 1 }
        }
      },
      "AnalysisSummary": {
        "type": "object",
        "required": ["id", "status", "cve_id", "component_url", "branch", "package_name", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "status": { "$ref": "#/components/schemas/Status" },
          "cve_id": { "type": "string" },
          "component_url": { "type": "string" },
          "branch": { "type": "string" },
          "package_name": { "type": "string" },
          "model": {
            "type": "string",
            "description": "Модель, которой дописан вывод. Если очередь исходной модели была переполнена, здесь резервная."
          },
          "created_at": { "type": "string", "format": "date-time" },
          "duration_ms": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "Сколько миллисекунд шёл сам анализ, без ожидания в очереди. null, пока задача в очереди. Для задачи в работе — текущее время минус старт."
          },
          "applicability": { "$ref": "#/components/schemas/Applicability" }
        }
      },
      "AnalysisTask": {
        "allOf": [
          { "$ref": "#/components/schemas/AnalysisSummary" },
          {
            "type": "object",
            "required": ["modules", "error_msg", "updated_at"],
            "properties": {
              "modules": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/AnalysisModule" }
              },
              "error_msg": { "type": "string", "description": "Сырой текст ошибки." },
              "error_source": {
                "type": "string",
                "description": "Кто виноват: AI HUB, CVE Patch Analyzer, Сервис патчей или Git. Считается по тексту ошибки, без модели."
              },
              "error_hint": {
                "type": "string",
                "description": "Короткая фраза для человека. Подробности остаются в error_msg."
              },
              "updated_at": { "type": "string", "format": "date-time" },
              "clone_ms": {
                "type": "integer",
                "format": "int64",
                "nullable": true,
                "description": "Сколько миллисекунд заняло клонирование ветки. null, пока клон не начинался. Остаётся и после ошибки, включая обрыв по дедлайну."
              },
              "ai_calls": {
                "type": "integer",
                "description": "Сколько раз анализ обращался к модели. Ноль, если обращений не было. Остаётся после ошибки и обрыва по дедлайну."
              },
              "ai_min_ms": {
                "type": "integer",
                "format": "int64",
                "nullable": true,
                "description": "Самое короткое ожидание ответа модели, в миллисекундах. null, если обращений не было."
              },
              "ai_max_ms": {
                "type": "integer",
                "format": "int64",
                "nullable": true,
                "description": "Самое долгое ожидание ответа модели, в миллисекундах. null, если обращений не было."
              }
            }
          }
        ]
      },
      "AnalysisModule": {
        "type": "object",
        "required": ["go_mod_path", "verdict", "applicability", "report_md"],
        "properties": {
          "go_mod_path": { "type": "string", "example": "go.mod" },
          "verdict": {
            "type": "string",
            "description": "Итоговый вывод по этому модулю."
          },
          "applicability": {
            "type": "string",
            "enum": ["applicable", "not_applicable", "uncertain"]
          },
          "report_md": {
            "type": "string",
            "description": "Журнал анализа текстом."
          }
        }
      },
      "Status": {
        "type": "string",
        "enum": ["PENDING", "RUNNING", "COMPLETED", "FAILED"]
      },
      "Applicability": {
        "type": "string",
        "nullable": true,
        "enum": ["applicable", "not_applicable", "uncertain"],
        "description": "null, пока задача не завершена."
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      }
    },
    "responses": {
      "Internal": {
        "description": "Внутренняя ошибка",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "internal error" }
          }
        }
      }
    }
  }
}
